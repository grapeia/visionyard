# Copie para .env e ajuste. .env não é versionado.
VISIONYARD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visionyard

# Em produção (atrás de TLS) mude para true.
VISIONYARD_COOKIE_SECURE=false

VISIONYARD_SESSION_IDLE_HOURS=12
VISIONYARD_SESSION_MAX_DAYS=7
VISIONYARD_PASSWORD_MIN_LENGTH=8
VISIONYARD_LOGIN_MAX_ATTEMPTS=10
VISIONYARD_LOGIN_WINDOW_MINUTES=15

# Importação de arquivo: raiz permitida (dumps do Label Studio e imagens).
VISIONYARD_IMPORT_ROOT=./data/imports

# Repositórios (buckets GCS) disponíveis na UI. JSON de lista de strings.
# Sem esta variável a UI não enxerga bucket nenhum.
VISIONYARD_BUCKETS=["meu-bucket-imagens"]
