# Configuração do deploy no GCP. Copie para `config.env` (não versionado) e
# preencha. Os dois scripts leem este arquivo: `provisionar.sh` uma vez por
# instalação, `publicar.sh` a cada versão.

# Projeto e região. A região vale para Cloud Run, Cloud SQL, Artifact Registry
# e os buckets de dados e de modelos — tudo junto, para o tráfego entre eles
# não atravessar continente nem pagar egress entre regiões.
PROJECT_ID=
REGION=southamerica-east1

# Domínio público. O certificado gerenciado só é emitido depois que o DNS deste
# nome aponta para o IP que o `provisionar.sh` reserva — ele imprime o IP.
DOMINIO=

# Prefixo dos nomes dos recursos (serviço, jobs, buckets, instância, conta).
PREFIXO=visionyard

# Bucket(s) de imagens que JÁ existem, separados por espaço. O provisionamento
# só concede leitura neles à conta da API; quem os lista para a tela é a aba
# Parâmetros (ou VISIONYARD_BUCKETS). Pode ficar vazio e ser concedido depois.
BUCKETS_IMAGENS=

# Cloud SQL. O tier decide o teto de conexões, e ele precisa caber
# MAX_INSTANCIAS × POOL_POR_INSTANCIA, mais folga para o job de migração e
# para quem abre um psql. db-custom-1-3840 aceita ~100; db-f1-micro só 25.
SQL_TIER=db-custom-1-3840
SQL_VERSAO=POSTGRES_16

# Cloud Run.
MAX_INSTANCIAS=4
POOL_POR_INSTANCIA=10
MEMORIA=2Gi
CPU=1
