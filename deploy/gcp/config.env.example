# Configuração do deploy no GCP. Copie para `config.env` (não versionado) e
# preencha. Os dois scripts leem este arquivo: `provisionar.sh` uma vez por
# instalação, `publicar.sh` a cada versão.

# Projeto e região. A região vale para Cloud Run, Cloud SQL, Artifact Registry
# e os buckets de dados e de modelos — tudo junto, para o tráfego entre eles
# não atravessar continente nem pagar egress entre regiões.
PROJECT_ID=
REGION=southamerica-east1

# Domínio público. O certificado gerenciado só é emitido depois que o DNS deste
# nome aponta para o IP que o `provisionar.sh` reserva — ele imprime o IP.
DOMINIO=

# Prefixo dos nomes dos recursos (serviço, jobs, buckets, instância, conta).
PREFIXO=visionyard

# Bucket(s) de imagens que JÁ existem, separados por espaço. O provisionamento
# só concede leitura neles à conta da API; quem os lista para a tela é a aba
# Parâmetros (ou VISIONYARD_BUCKETS). Pode ficar vazio e ser concedido depois.
BUCKETS_IMAGENS=

# Postgres. `sim`: o provisionamento cria uma instância Cloud SQL própria.
# `nao`: usa um banco que já existe e não cria nada de SQL — o provisionamento
# pede o DSN (sem eco) e o guarda no Secret Manager. Nesse caso:
#   - Cloud SQL que já existe: SQL_CONEXAO=projeto:regiao:instancia, e o DSN
#     usa o socket: postgresql://USUARIO:SENHA@/BANCO?host=/cloudsql/projeto:regiao:instancia
#   - Postgres fora do Cloud SQL: SQL_CONEXAO vazio, e o DSN aponta para um
#     endereço que o Cloud Run alcance pela internet (com sslmode=require).
# O banco e o usuário precisam existir; as tabelas, o `publicar.sh` cria.
SQL_CRIAR=sim
SQL_CONEXAO=

# Só quando SQL_CRIAR=sim. O tier decide o teto de conexões, e ele precisa
# caber MAX_INSTANCIAS × POOL_POR_INSTANCIA, mais folga para o job de migração
# e para quem abre um psql. db-custom-1-3840 aceita ~100; db-f1-micro só 25.
SQL_TIER=db-custom-1-3840
SQL_VERSAO=POSTGRES_16

# Cloud Run.
MAX_INSTANCIAS=4
POOL_POR_INSTANCIA=10
MEMORIA=2Gi
CPU=1
