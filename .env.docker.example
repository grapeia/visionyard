# Ambiente do deploy em container. Copie para `.env.docker` e preencha.
# `.env.docker` não é versionado. Não confundir com `.env`, que é o do
# desenvolvimento local (venv + Postgres da máquina).

# Senha do Postgres da instalação. Sem default de propósito: `docker compose`
# recusa subir enquanto estiver vazia.
POSTGRES_PASSWORD=

# Conta de serviço GCS com leitura do bucket de imagens. Caminho no HOST — o
# compose monta como somente leitura em /run/secrets/gcp-sa.json.
GCP_CREDENTIALS_FILE=/opt/visionyard/gcp-sa.json

# Porta publicada no loopback do host, para o proxy que termina TLS apontar.
API_PORT=8000
UVICORN_WORKERS=4

# --- Aplicação -------------------------------------------------------------

# Em produção a API fica atrás de TLS, então o cookie de sessão é secure.
VISIONYARD_COOKIE_SECURE=true

# IP de origem: a API só aceita X-Forwarded-For quando o salto imediato está
# nesta lista (api/auth.py). Atrás de container o salto imediato é o gateway da
# rede do compose — por isso a subnet abaixo. Se este valor estiver errado, todo
# login parece vir do mesmo IP e o teto de 10 tentativas por janela passa a
# valer para o conjunto dos usuários, não por pessoa.
VISIONYARD_TRUSTED_PROXIES=["172.28.0.0/16"]

# Buckets GCS que a instalação enxerga. Sem isto a UI não navega imagem nenhuma.
VISIONYARD_BUCKETS=["meu-bucket-imagens"]

# Raiz permitida para importação de arquivo. É uma cerca, não conveniência:
# fica sob o volume de dados do container.
VISIONYARD_IMPORT_ROOT=/app/data/imports
VISIONYARD_MANIFEST_ROOT=/app/data/manifests

# Sessão e senha — defaults do produto, descomente para ajustar.
# VISIONYARD_SESSION_IDLE_HOURS=12
# VISIONYARD_SESSION_MAX_DAYS=7
# VISIONYARD_PASSWORD_MIN_LENGTH=12
# VISIONYARD_LOGIN_MAX_ATTEMPTS=10
# VISIONYARD_LOGIN_WINDOW_MINUTES=15
